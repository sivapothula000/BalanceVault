generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
}

model Account {
  id        String        @id @default(uuid())
  accountNo String        @unique
  balance   Decimal       @default(0) @db.Decimal(15, 2)
  status    AccountStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId            String
  user              User          @relation(fields: [userId], references: [id])
  ledgerEntries     LedgerEntry[]
  sentTransfers     Transfer[]    @relation("TransferSource")
  receivedTransfers Transfer[]    @relation("TransferDestination")

  @@index([userId, status])
}

model Transfer {
  id                   String         @id @default(uuid())
  sourceAccountId      String
  destinationAccountId String
  amount               Decimal        @db.Decimal(15, 2)
  status               TransferStatus @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  sourceAccount      Account       @relation("TransferSource", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account       @relation("TransferDestination", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]

  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([status, createdAt])
}

model LedgerEntry {
  id         String          @id @default(uuid())
  accountId  String
  transferId String
  type       LedgerEntryType
  amount     Decimal         @db.Decimal(15, 2)
  createdAt  DateTime        @default(now())

  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@unique([transferId, type])
  @@index([accountId, createdAt])
}
